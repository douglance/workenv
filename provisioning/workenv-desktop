#!/usr/bin/env bash
# Install and start a minimal remote desktop in a guest, plus a demo counter
# server, and publish it over the tailnet.
#
#   workenv-desktop --number 3 [--port 8300] [--display 1] [--geometry 1280x800]
#
# Idempotent: re-running reuses what is already installed and restarts the
# session. Deliberately light — four of these share one 8 GB Mac mini, so this
# is Xvnc + openbox + a WebKit browser, never a full desktop environment.
set -euo pipefail

NUMBER=1; PORT=""; DISPLAY_NUM=1; GEOMETRY="1280x800"; WEB_PORT=""; STATUS=0
while [ $# -gt 0 ]; do
  case "$1" in
    --status)   STATUS=1; shift ;;
    --number)   NUMBER="$2"; shift 2 ;;
    --port)     PORT="$2"; shift 2 ;;
    --web-port) WEB_PORT="$2"; shift 2 ;;
    --display)  DISPLAY_NUM="$2"; shift 2 ;;
    --geometry) GEOMETRY="$2"; shift 2 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done
PORT="${PORT:-$((8300 + NUMBER))}"
WEB_PORT="${WEB_PORT:-6080}"
STATE="$HOME/.local/state/workenv-desktop"
export DISPLAY=":$DISPLAY_NUM"
mkdir -p "$STATE"
log() { printf '\n=== %s ===\n' "$*"; }

# Report what is actually running, reading the recorded manifest rather than
# re-deriving it. Liveness is measured, not assumed: the counter has to advance
# between two samples to be called up.
if [ "$STATUS" = 1 ]; then
  [ -f "$STATE/desktop.json" ] || { echo "no desktop on this guest"; exit 1; }
  python3 - "$STATE/desktop.json" <<'STATUS_EOF'
import json, subprocess, sys, time, urllib.request
m = json.load(open(sys.argv[1]))
print(json.dumps(m, indent=2))
# Asked of systemd by unit name, not guessed with a pgrep pattern. A pattern
# matched against a truncated argv is the same unreliable test the launches were
# replaced for, and it reports a dead component as present just as easily.
def active(unit):
    return subprocess.run(["systemctl", "--user", "is-active", "--quiet", unit],
                          capture_output=True).returncode == 0
checks = [(unit, active(f"{unit}.service")) for unit in (
    "workenv-counter", "workenv-xvnc", "workenv-wm",
    "workenv-xterm", "workenv-browser", "workenv-novnc",
)]
try:
    url = f"http://127.0.0.1:{m['counter_port']}/raw"
    read = lambda: float(urllib.request.urlopen(url, timeout=5).read())
    a = read(); time.sleep(1.2); b = read()
    checks.append(("counter advancing", b > a))
except Exception as exc:
    checks.append((f"counter unreachable ({exc})", False))
for name, ok in checks:
    print(f"  {'up  ' if ok else 'DOWN'}  {name}")
sys.exit(0 if all(ok for _, ok in checks) else 1)
STATUS_EOF
  exit $?
fi

log "1/6 packages"
# Every one of xfonts-base, x11-xserver-utils and python3-numpy is a *Recommends*,
# and this guest installs with --no-install-recommends. xfonts-base carries the
# `fixed` and `cursor` fonts without which Xvnc aborts at startup; numpy is the
# difference between usable and painful websockify frame rates.
NEED="tigervnc-standalone-server tigervnc-common xfonts-base x11-xserver-utils
      xauth x11-utils openbox xterm dbus-x11 scrot novnc websockify python3-numpy
      epiphany-browser wmctrl"
# Every package is checked, not one sentinel. This used to test only
# tigervnc-standalone-server and skip the whole install when it was present, so a
# guest that had tigervnc from any other source silently never got the other
# fourteen -- and the first symptom was xterm failing to exec, minutes later, in
# a log nobody reads. A guard that represents one member of a set is not a guard
# for the set.
MISSING=""
for pkg in $NEED; do
  dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q "install ok installed" \
    || MISSING="$MISSING $pkg"
done
if [ -n "$MISSING" ]; then
  echo "  installing:$MISSING"
  export DEBIAN_FRONTEND=noninteractive
  # Cloud images hold the dpkg lock at first boot; waiting beats failing.
  for _ in $(seq 1 60); do sudo fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1 || break; sleep 5; done
  sudo apt-get update -qq
  # shellcheck disable=SC2086
  sudo apt-get install -y -qq --no-install-recommends $MISSING
  # Assert the set is actually satisfied rather than trusting apt's exit code,
  # which is 0 when a package is held back or renamed.
  STILL=""
  for pkg in $NEED; do
    dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q "install ok installed" \
      || STILL="$STILL $pkg"
  done
  [ -z "$STILL" ] || { echo "packages still missing after install:$STILL" >&2; exit 1; }
else
  echo "  all $(printf '%s\n' $NEED | wc -l | tr -d ' ') packages already present"
fi

log "2/6 counter server"
# Serves "<N>.<six digits>" where the integer part identifies the workspace and
# the decimals advance 100x a second, computed server-side. The page refreshes
# itself once a second, which works in any browser without JavaScript.
cat > "$STATE/counter.py" <<'PYEOF'
import sys, time
from http.server import BaseHTTPRequestHandler, HTTPServer

NUMBER = int(sys.argv[1]); PORT = int(sys.argv[2]); START = time.time()

def value():
    return f"{NUMBER}.{int((time.time() - START) * 100) % 1000000:06d}"

PAGE = """<!doctype html><meta charset=utf-8>
<meta http-equiv="refresh" content="1">
<title>workspace {n}</title>
<style>
 html,body{{height:100%;margin:0;background:#11141a;color:#e6edf3;
   font:600 15px/1.4 ui-sans-serif,system-ui,sans-serif;
   display:flex;flex-direction:column;align-items:center;justify-content:center}}
 .tag{{letter-spacing:.28em;text-transform:uppercase;color:#7d8590;font-size:13px}}
 .v{{font:700 96px/1 ui-monospace,SFMono-Regular,Menlo,monospace;
   margin:.18em 0;color:#58a6ff;font-variant-numeric:tabular-nums}}
 .m{{color:#7d8590;font-size:13px}}
</style>
<div class=tag>workspace {n}</div>
<div class=v>{v}</div>
<div class=m>served by {h} &middot; counting since start</div>
"""

class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        import socket
        if self.path == "/raw":
            body = value().encode()
            ctype = "text/plain"
        else:
            body = PAGE.format(n=NUMBER, v=value(), h=socket.gethostname()).encode()
            ctype = "text/html; charset=utf-8"
        self.send_response(200)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)
    def log_message(self, *_):
        pass

HTTPServer(("127.0.0.1", PORT), Handler).serve_forever()
PYEOF
# Two samples, asserted strictly increasing. A single successful request proves
# only that something is listening; it passes just as happily on a counter frozen
# at its start value, which is the one failure this demo exists to rule out.
verify_counter() {
  python3 - "$PORT" <<'CHECK'
import sys, time, urllib.request
url = f"http://127.0.0.1:{sys.argv[1]}/raw"
read = lambda: float(urllib.request.urlopen(url, timeout=5).read())
a = read(); time.sleep(1.2); b = read()
if not b > a:
    sys.exit(f"counter is not advancing: {a} then {b}")
print(f"  counter serving {sys.argv[1]}: {a:.6f} -> {b:.6f} (advancing)")
CHECK
}
log "3/6 supervised units"
# Every component is a systemd user unit, not a nohup'd background job. Three
# defects this removes, all of them admitted in this script's own former
# comments:
#
#   * `pkill -f` matches against an argv the kernel truncates, so a pattern
#     anchored on the tail of a long command line silently matches nothing --
#     indistinguishable from a process that was already stopped. Units are
#     stopped by exact name.
#   * nothing restarted a crashed component and nothing started any of it after
#     a reboot, so a guest came back looking healthy with no desktop on it.
#   * `sleep N` after each launch is a guess. The X socket appearing is the real
#     readiness signal, and systemd orders everything else behind it.
UNITS="$HOME/.config/systemd/user"
mkdir -p "$UNITS"
RFB_PORT=$((5900 + DISPLAY_NUM))

# Without lingering the user manager is torn down with the last login session,
# taking every unit with it. This is the reboot-survival half and it is required.
loginctl enable-linger "$USER" 2>/dev/null || sudo loginctl enable-linger "$USER"
loginctl show-user "$USER" 2>/dev/null | grep -q 'Linger=yes' \
  || { echo "lingering did not take effect; units would die with the session" >&2; exit 1; }

# The readiness probe is a file, never inline in a unit. systemd performs no
# command substitution, and an unquoted heredoc expands `$(seq ...)` at write
# time -- which produced an 80-line ExecStartPost and "bad unit file setting".
# Found by running it in a guest.
cat > "$STATE/wait-for-x.sh" <<'PROBE'
#!/bin/sh
display="$1"
i=0
while [ "$i" -lt 80 ]; do
  [ -e "/tmp/.X11-unix/X$display" ] && exit 0
  i=$((i + 1))
  sleep 0.25
done
echo "X display :$display never appeared" >&2
exit 1
PROBE
chmod +x "$STATE/wait-for-x.sh"

cat > "$UNITS/workenv-counter.service" <<UNIT
[Unit]
Description=workenv demo counter for workspace $NUMBER
[Service]
ExecStart=/usr/bin/python3 $STATE/counter.py $NUMBER $PORT
Restart=always
RestartSec=1
[Install]
WantedBy=default.target
UNIT

# -localhost: the framebuffer listens on loopback and no other interface, so it
# is never reachable by accident. Every route in is explicit: `tailscale serve`
# in the guest, or workenv-desk-forward on the VM host. SecurityTypes None means
# there is NO VNC password on either route -- the tailnet ACL is the whole access
# control. See "Access control" in provisioning/README.md.
cat > "$UNITS/workenv-xvnc.service" <<UNIT
[Unit]
Description=workenv Xvnc display $DISPLAY
[Service]
ExecStart=/usr/bin/Xvnc $DISPLAY -geometry $GEOMETRY -depth 24 -rfbport $RFB_PORT -localhost -SecurityTypes None -desktop workspace-$NUMBER
ExecStartPost=/bin/sh $STATE/wait-for-x.sh $DISPLAY_NUM
Restart=always
RestartSec=1
[Install]
WantedBy=default.target
UNIT

cat > "$UNITS/workenv-wm.service" <<UNIT
[Unit]
Description=workenv window manager
Requires=workenv-xvnc.service
After=workenv-xvnc.service
[Service]
Environment=DISPLAY=$DISPLAY
ExecStartPre=-/usr/bin/xsetroot -solid #11141a
ExecStart=/usr/bin/openbox
Restart=always
RestartSec=1
[Install]
WantedBy=default.target
UNIT

# A terminal tailing the raw value, so the number is visible even when the
# browser fails to start. Belt and braces on a demo that must be seen.
cat > "$UNITS/workenv-xterm.service" <<UNIT
[Unit]
Description=workenv raw value terminal
Requires=workenv-wm.service workenv-counter.service
After=workenv-wm.service workenv-counter.service
[Service]
Environment=DISPLAY=$DISPLAY
ExecStart=/usr/bin/xterm -geometry 46x6+16+16 -fa DejaVuSansMono -fs 11 -bg #11141a -fg #7ee787 -T "workspace-$NUMBER raw" -e watch -n1 -t curl -fsS http://127.0.0.1:$PORT/raw
Restart=always
RestartSec=2
[Install]
WantedBy=default.target
UNIT

cat > "$UNITS/workenv-browser.service" <<UNIT
[Unit]
Description=workenv kiosk browser
Requires=workenv-wm.service workenv-counter.service
After=workenv-wm.service workenv-counter.service
[Service]
Environment=DISPLAY=$DISPLAY
ExecStart=/usr/bin/epiphany-browser http://127.0.0.1:$PORT/
Restart=always
RestartSec=2
[Install]
WantedBy=default.target
UNIT

# Serving noVNC's own web root means the page and the websocket share one origin,
# so noVNC's defaults are already correct and no query parameters are needed --
# which sidesteps the Tailscale Serve bug that strips them.
cat > "$UNITS/workenv-novnc.service" <<UNIT
[Unit]
Description=workenv noVNC web gateway
Requires=workenv-xvnc.service
After=workenv-xvnc.service
[Service]
ExecStart=/usr/bin/websockify --web=/usr/share/novnc 127.0.0.1:$WEB_PORT 127.0.0.1:$RFB_PORT
Restart=always
RestartSec=1
[Install]
WantedBy=default.target
UNIT

log "4/6 browser first-run settings"
# Epiphany asks to become the default browser on first run and the modal covers
# the page, which is precisely what we are here to look at. Answer it in advance.
# restore-session-policy takes 'always' or 'crashed' and there is NO 'never';
# setting one fails with "value is outside of the valid range", which an earlier
# 2>/dev/null swallowed whole -- so the browser kept restoring every previous
# tab, failed loads included, while the script reported success.
set_gsetting() {
  gsettings set "$1" "$2" "$3" 2>/dev/null || { echo "  WARNING: could not set $1 $2" >&2; return 0; }
  [ "$(gsettings get "$1" "$2" 2>/dev/null)" = "$4" ] \
    || echo "  WARNING: $1 $2 did not stick" >&2
}
set_gsetting org.gnome.Epiphany ask-for-default false false
set_gsetting org.gnome.Epiphany restore-session-policy crashed "'crashed'"
rm -f "$HOME/.local/share/epiphany/session_state.xml" 2>/dev/null || true

log "5/6 start and verify"
UNIT_NAMES=(workenv-counter workenv-xvnc workenv-wm workenv-xterm workenv-browser workenv-novnc)
SERVICES=("${UNIT_NAMES[@]/%/.service}")
systemctl --user daemon-reload
for u in "${UNIT_NAMES[@]}"; do systemctl --user enable "$u.service" >/dev/null 2>&1 || true; done
# One restart for the whole set, so systemd applies the Requires/After ordering
# itself instead of the script bouncing dependents one at a time.
systemctl --user restart "${SERVICES[@]}"
failed=()
for u in "${UNIT_NAMES[@]}"; do
  systemctl --user is-active --quiet "$u.service" || failed+=("$u")
done
[ ${#failed[@]} -eq 0 ] || {
  echo "not active: ${failed[*]}" >&2
  systemctl --user --no-pager status "${failed[@]/%/.service}" 2>&1 | tail -24
  exit 1
}
echo "  units active: ${UNIT_NAMES[*]}"
verify_counter

log "6/6 publish"
curl -fsS -o /dev/null "http://127.0.0.1:$WEB_PORT/vnc.html" && echo "  noVNC on $WEB_PORT"

if command -v tailscale >/dev/null 2>&1 && tailscale status >/dev/null 2>&1; then
  if serve_err="$(sudo tailscale serve --bg --https=443 "http://127.0.0.1:$WEB_PORT" 2>&1)"; then
    echo "  published: https://$(tailscale status --json |
      python3 -c 'import sys,json;print(json.load(sys.stdin)["Self"]["DNSName"].rstrip("."))')/"
  else
    # Not fatal: the VM host can publish this guest with workenv-desk-forward
    # instead. But it must be said out loud, or a failed publish reads as a
    # successful one that simply printed no URL.
    echo "  WARNING: tailscale serve failed, guest is not published on the tailnet" >&2
    printf '  %s\n' "$serve_err" >&2
  fi
else
  echo "  note: no tailscale in this guest; publish from the VM host with workenv-desk-publish"
fi
# Recording this is the difference between asking the desktop what port it uses
# and guessing. Guessing cost three wrong probes before /proc/net/tcp gave it up.
python3 - "$STATE/desktop.json" <<MANIFEST
import json, sys
json.dump({
    "number": $NUMBER, "counter_port": $PORT, "web_port": $WEB_PORT,
    "display": "$DISPLAY", "rfb_port": $((5900 + DISPLAY_NUM)),
    "geometry": "$GEOMETRY", "state_dir": "$STATE",
}, open(sys.argv[1], "w"), indent=2)
MANIFEST
echo "DESKTOP_READY number=$NUMBER port=$PORT display=$DISPLAY web=$WEB_PORT"
