#!/usr/bin/env bash
# Enrol a Mac as an Orchard worker so environments can be placed on it.
#
#   workenv-worker-enroll <ssh-target> [worker-name] [tart-vm-slots]
#   workenv-worker-enroll --local      [worker-name] [tart-vm-slots]
#
# Runs on the controller. Installs tart and orchard on the target, opens a
# reverse tunnel for the controller API, mints a bootstrap token, and starts
# the worker. Idempotent: re-running replaces the worker process.
#
# `--local` enrols the controller Mac itself. The controller is the largest
# machine in the fleet and sat outside it entirely, so every guest was scheduled
# onto the smallest worker -- and `workenv-base` is a `local` tart image on this
# machine, which no other worker can pull. Two of the five steps are
# specifically about reaching somewhere else and are skipped: the tools are
# already here, and a reverse tunnel to 127.0.0.1 would forward the controller
# API to itself. `bash -c` stands in for `ssh <target>` so steps 3-5 stay one
# implementation rather than two that drift.
set -euo pipefail

TARGET="${1:?usage: workenv-worker-enroll <ssh-target|--local> [name] [slots]}"
LOCAL=0
if [ "$TARGET" = "--local" ]; then
  LOCAL=1
  NAME="${2:-$(hostname -s)}"
else
  NAME="${2:-$(printf '%s' "$TARGET" | sed 's/.*@//; s/\..*//')}"
fi
SLOTS="${3:-1}"
PORT="${WORKENV_ORCHARD_PORT:-6120}"
ORCHARD_VERSION="${WORKENV_ORCHARD_VERSION:-0.56.1}"
TART_VERSION="${WORKENV_TART_VERSION:-2.37.0}"
if [ "$LOCAL" = 1 ]; then
  SSH=(bash -c)
else
  SSH=(ssh -o BatchMode=yes -o ConnectTimeout=20 "$TARGET")
fi
step() { printf '\n\033[36m### %s\033[0m\n' "$*"; }

step "1/5 install tart and orchard on $TARGET"
# Downloaded on the target, not copied from here: copying a signed Mach-O
# invalidates its signature and the binary is then SIGKILLed on exec with no
# message other than "Killed: 9".
#
# Locally the tools are already installed -- but where is not assumed: tart is a
# Homebrew install here, not the `~/.local/bin/tart` the remote path creates, so
# a check hardcoding that path reports a machine with tart as having none. The
# worker plist resolves orchard through `$HOME/.local/bin`, so that one is
# checked at the path the plist will actually use.
if [ "$LOCAL" = 1 ]; then
  command -v tart >/dev/null || { echo "tart is not installed on this Mac" >&2; exit 1; }
  [ -x "$HOME/.local/bin/orchard" ] || {
    echo "orchard is not at $HOME/.local/bin/orchard, which the worker plist requires" >&2
    exit 1
  }
  printf '  tart %s / orchard %s\n' \
    "$(tart --version 2>&1 | head -1)" \
    "$("$HOME/.local/bin/orchard" --version 2>&1 | head -1)"
else
"${SSH[@]}" "
  set -e
  mkdir -p ~/.local/bin /tmp/wkv-install && cd /tmp/wkv-install
  if ! ~/.local/bin/tart --version >/dev/null 2>&1; then
    curl -fsSL -o tart.tar.gz https://github.com/openai/tart/releases/download/${TART_VERSION}/tart.tar.gz
    tar xzf tart.tar.gz
    rm -rf ~/.local/share/tart.app && mkdir -p ~/.local/share && mv tart.app ~/.local/share/
    ln -sf ~/.local/share/tart.app/Contents/MacOS/tart ~/.local/bin/tart
  fi
  if ! ~/.local/bin/orchard --version >/dev/null 2>&1; then
    curl -fsSL -o orchard.tgz https://github.com/openai/orchard/releases/download/${ORCHARD_VERSION}/orchard-darwin-arm64.tar.gz
    tar xzf orchard.tgz && install -m 755 orchard ~/.local/bin/orchard
    xattr -d com.apple.quarantine ~/.local/bin/orchard 2>/dev/null || true
    # spctl rejects the release binary as 'not an app' even though it carries a
    # valid Developer ID, and the kernel kills it. An ad-hoc re-sign fixes it.
    codesign --force --sign - ~/.local/bin/orchard
  fi
  printf '  tart %s / orchard %s\n' \
    \"\$(~/.local/bin/tart --version 2>&1 | head -1)\" \
    \"\$(~/.local/bin/orchard --version 2>&1 | head -1)\"
"
fi

step "2/5 reverse tunnel for the controller API"
if [ "$LOCAL" = 1 ]; then
  echo "  skipped: the controller API is already on 127.0.0.1:$PORT here"
else
# A tagged worker cannot dial a user-owned controller under the default tailnet
# grant (src is autogroup:member only), and the connection times out with no
# diagnostic. The controller can always dial the worker, so the tunnel runs the
# other way. Grant tag:<worker> -> controller:$PORT in the policy to drop this.
# Supervised, not nohup'd. An unsupervised tunnel is the single process the
# whole worker depends on, and when it dies the worker leaves the fleet with no
# signal -- it just stops being scheduled onto.
TUNNEL_LABEL="dev.workenv.orchard-tunnel.$NAME"
TUNNEL_PLIST="$HOME/Library/LaunchAgents/$TUNNEL_LABEL.plist"
mkdir -p "$HOME/Library/LaunchAgents" "$HOME/Library/Logs/workenv"
cat > "$TUNNEL_PLIST" <<PLIST_EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$TUNNEL_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/ssh</string><string>-N</string>
    <string>-o</string><string>BatchMode=yes</string>
    <string>-o</string><string>ExitOnForwardFailure=yes</string>
    <string>-o</string><string>ServerAliveInterval=30</string>
    <string>-o</string><string>ServerAliveCountMax=3</string>
    <string>-R</string><string>$PORT:127.0.0.1:$PORT</string>
    <string>$TARGET</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardErrorPath</key><string>$HOME/Library/Logs/workenv/orchard-tunnel-$NAME.log</string>
</dict>
</plist>
PLIST_EOF
launchctl bootout "gui/$UID/$TUNNEL_LABEL" 2>/dev/null || true
launchctl bootstrap "gui/$UID" "$TUNNEL_PLIST"
# KeepAlive outlives this script, and every step after this one fails by an
# explicit `exit 1`: the reachability probe, the token mint, the verify. Without
# a teardown a failed enrol left a permanent `ssh -R` agent re-dialling $TARGET
# with nothing on either end using the forward. Hung off EXIT rather than ERR
# because, measured, bash runs no ERR trap for an explicit exit -- an ERR trap
# here would have caught none of the three paths that actually fail.
drop_tunnel_unless_ok() {
  [ "$1" -eq 0 ] || launchctl bootout "gui/$UID/$TUNNEL_LABEL" 2>/dev/null || true
}
trap 'drop_tunnel_unless_ok "$?"' EXIT
sleep 4
# 401 means reachable and authenticating, which is the goal. `curl -f` would
# read a correctly-secured controller as an unreachable one.
REMOTE_CODE="$("${SSH[@]}" "curl -s -o /dev/null -w '%{http_code}' --max-time 8 http://127.0.0.1:$PORT/v1/workers" || true)"
case "$REMOTE_CODE" in
  200|401|403) ;;
  *) echo "controller API is not reachable from $TARGET (got '$REMOTE_CODE')" >&2; exit 1 ;;
esac
echo "  controller API reachable from $TARGET"
fi

step "3/5 bootstrap token"
orchard create service-account workers --roles compute:write --roles compute:read >/dev/null 2>&1 || true
TOKEN="$(orchard get bootstrap-token workers | tail -1)"
[ -n "$TOKEN" ] || { echo "could not mint a bootstrap token" >&2; exit 1; }

step "4/5 start the worker"
# Two hops, deliberately. Interpolating a remote script inside a double-quoted
# ssh argument means every `$HOME` and `$(id -u)` expands on the CONTROLLER:
# an earlier version wrote the worker's token to the controller's own home and
# started the worker with no controller URL at all. The token goes over stdin
# on its own, then the setup script goes over stdin with nothing to expand.
printf '%s' "$TOKEN" | "${SSH[@]}" '
  umask 077
  mkdir -p "$HOME/.orchard" && chmod 700 "$HOME/.orchard"
  cat > "$HOME/.orchard/worker-token"
  chmod 600 "$HOME/.orchard/worker-token"
'
# The token is read from that 0600 file on every start, never passed in argv.
# Measured, not assumed: an earlier version supplied it once, on the theory that
# it created a durable identity, and the supervised worker then crash-looped on
# "no bootstrap token was provided" while `orchard list workers` still showed
# the worker present -- because what the controller had seen was the one-shot
# enrolment process, which then exited. `orchard worker run` has no
# persisted-credential flag.
# The worker shells out to tart to build guests, so tart must be on the PATH the
# plist declares -- and launchd gives a job none of the login shell's. Remotely
# step 1 installs tart into ~/.local/bin, which that PATH already carries; on
# this Mac it is a Homebrew install at /opt/homebrew/bin, which it does not. The
# directory is measured from the tart that is actually there rather than
# assumed, because the failure is silent in the worst way: the worker registers,
# advertises its slots, is scheduled onto, and only then fails every create.
if [ "$LOCAL" = 1 ]; then
  TART_DIR="$(dirname "$(command -v tart)")"
else
  TART_DIR="\$HOME/.local/bin"
fi
# Labels are scheduling constraints, not metadata: a worker carries none by
# default, and *any* label on a guest disqualifies every worker that lacks it.
# That is exactly the property needed here -- `workenv-base` is a `local` tart
# image on one machine, so a guest asking for it must land on that machine or
# fail with "the specified VM \"workenv-base\" does not exist", which is the
# original symptom this whole path exists to fix. The label is what makes
# placement follow the image instead of being a coin toss between workers.
LABELS="${WORKENV_WORKER_LABELS-${WORKENV_WORKER_LABELS_DEFAULT:-}}"
if [ "$LOCAL" = 1 ] && [ -z "${WORKENV_WORKER_LABELS+set}" ]; then
  LABELS="image=workenv-base"
fi
[ -n "$LABELS" ] && echo "  labels: $LABELS"
"${SSH[@]}" "bash -s -- '$PORT' '$NAME' '$SLOTS' '$TART_DIR' '$LABELS'" <<'REMOTE'
set -eu
PORT="$1"; NAME="$2"; SLOTS="$3"; TART_DIR="$4"; LABELS="${5:-}"
# Omitted entirely when empty: `--labels ""` is not the same as no labels.
LABEL_ARG=""
[ -n "$LABELS" ] && LABEL_ARG="--labels $LABELS"
AGENT="$HOME/Library/LaunchAgents/dev.workenv.orchard-worker.plist"
mkdir -p "$HOME/Library/LaunchAgents" "$HOME/Library/Logs/workenv"
chmod 700 "$HOME/Library/Logs/workenv" 2>/dev/null || true
cat > "$AGENT" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.workenv.orchard-worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string><string>-c</string>
    <string>exec $HOME/.local/bin/orchard worker run http://127.0.0.1:$PORT --name $NAME --bootstrap-token-stdin --resources org.cirruslabs.tart-vms=$SLOTS $LABEL_ARG &lt; $HOME/.orchard/worker-token</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>$TART_DIR:$HOME/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>StandardOutPath</key><string>$HOME/Library/Logs/workenv/orchard-worker.log</string>
  <key>StandardErrorPath</key><string>$HOME/Library/Logs/workenv/orchard-worker.log</string>
</dict>
</plist>
PLIST
pkill -f 'orchard worker run' 2>/dev/null || true
launchctl bootout "gui/$(id -u)/dev.workenv.orchard-worker" 2>/dev/null || true
launchctl bootstrap "gui/$(id -u)" "$AGENT"
sleep 8
REMOTE

step "5/5 verify"
for _ in $(seq 1 20); do
  orchard list workers 2>/dev/null | grep -q "^$NAME" && break
  sleep 2
done
# Gated on the worker's own row, never on the table. `grep -E "^Name|^$NAME"`
# matched the header `orchard list workers` always prints, so this step passed
# whatever happened and reported an enrolled worker that had never registered.
orchard list workers 2>/dev/null | grep -q "^$NAME" || {
  echo "worker $NAME did not register" >&2; exit 1; }
orchard list workers 2>/dev/null || true
echo "worker $NAME enrolled"
