#!/usr/bin/env bash
# Seed a provisioned guest with one identity, plus the operator's tooling.
# Runs on the CONTROLLER. Secrets stream over ssh and are never printed.
#
#   workenv-seed --via <exedev|orchard> <vm> --identity <profile>
#   workenv-seed <ssh-target>               --identity <profile>
#
# Two kinds of material, and the difference is the whole point of the script:
#
#   identity   .claude/.credentials.json, .codex/auth.json, .grok/auth.json,
#              .gh/hosts.yml, .gitconfig -- taken ONLY from the named profile's
#              tree, never from the controller's own $HOME. A guest therefore
#              holds exactly one identity and has nothing of any other.
#   tooling    skills, commands, agents, CLAUDE.md, AGENTS.md -- the operator's
#              working material, identical whoever is logged in, taken from $HOME.
#
# Some credentials are legitimately shared. Anthropic auth is one store holding
# several accounts, selected by ANTHROPIC_PROFILE, so two profiles can carry a
# byte-identical .claude/.credentials.json and still be different identities.
# That selection is a mechanism, not a label, so it is installed here as
# ~/.workenv-identity and sourced by the guest's login shell -- and
# workenv-identity-check reads it back rather than assuming it took.
#
# There is deliberately no fallback from a profile to $HOME. Falling back is the
# bug this exists to prevent: it turns "the work profile has no login yet" into
# "the work guest silently ran as the personal account", which is invisible
# precisely because everything works.
set -euo pipefail
log() { printf '\n=== %s ===\n' "$*"; }
die() { printf 'workenv-seed: %s\n' "$*" >&2; exit 1; }

PROFILES_DIR="${WORKENV_PROFILES_DIR:-$HOME/.config/workenv/profiles}"
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKEND=""
SLOT=""
TARGET=""
IDENTITY=""

while [ $# -gt 0 ]; do
  case "$1" in
    --via)      BACKEND="${2:?--via needs exedev or orchard}"; SLOT="${3:?--via needs a vm name}"; shift 3 ;;
    --exedev)   BACKEND=exedev; SLOT="${2:?--exedev needs a vm name}"; shift 2 ;;
    --identity) IDENTITY="${2:?--identity needs a profile name}"; shift 2 ;;
    -*)         die "unknown option $1" ;;
    *)          TARGET="$1"; shift ;;
  esac
done

[ -n "$IDENTITY" ] || die "--identity <profile> is required.
  A guest with no named identity is a guest running on whatever credentials this
  machine happens to hold, which is the failure the profiles exist to prevent.
  Profiles live under $PROFILES_DIR; create one with workenv-profile-import."

PROFILE="$PROFILES_DIR/$IDENTITY"
[ -d "$PROFILE" ] || die "no profile '$IDENTITY' at $PROFILE.
  Prepare it with:  workenv --root fleet extension call workenv.identity apply --environment workenv
  then log it in:   workenv-profile-import $IDENTITY   (or the adapter's interactive login)"

# Identity material, profile-relative source -> guest-relative destination.
# `.gh/hosts.yml` becomes the guest's gh config because the profile's .gitconfig
# delegates the GitHub credential to `gh auth git-credential`; without it the
# guest can clone a public repo and push nothing.
spec_field() { # $1 = field -> value, or empty
  [ -f "$PROFILE/profile.json" ] || return 0
  python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["spec"].get(sys.argv[2],""))' \
    "$PROFILE/profile.json" "$1" 2>/dev/null || true
}

# The guest's copy of who it is. A file rather than an exported variable because
# the agent runs through several shells and a relay, and because the check that
# follows needs to read the selection back rather than trust that it was made.
identity_marker() {
  printf 'WORKENV_PROFILE=%s\n' "$IDENTITY"
  anthropic="$(spec_field anthropic_profile)"
  [ -n "$anthropic" ] && printf 'ANTHROPIC_PROFILE=%s\n' "$anthropic"
  return 0
}

# Sourced from both, because a relay exec gets .bashrc and a login shell gets
# .profile, and an identity that applies in only one of them is an identity that
# applies when nobody is looking.
MARKER_BLOCK='# >>> workenv identity >>>
set -a; . "$HOME/.workenv-identity"; set +a
# <<< workenv identity <<<'

identity_files() {
  printf '%s\n' \
    ".claude/.credentials.json:.claude/.credentials.json" \
    ".codex/auth.json:.codex/auth.json" \
    ".grok/auth.json:.grok/auth.json" \
    ".gh/hosts.yml:.config/gh/hosts.yml" \
    ".gitconfig:.gitconfig"
}

# Operator tooling. Not identity: the same files whoever is logged in.
tooling_files() {
  printf '%s\n' \
    "$HOME/.claude/CLAUDE.md:.claude/CLAUDE.md" \
    "$HOME/.claude/settings.json:.claude/settings.json" \
    "$HOME/.codex/AGENTS.md:.codex/AGENTS.md" \
    "$HOME/.agents/AGENTS.md:.agents/AGENTS.md"
}

present=0
missing=0

# --- exe.dev guests -------------------------------------------------------
# A scheduled exe.dev VM has no address to ssh to, and no stdin through its
# relay: `ssh exe.dev ssh <vm> 'cat > file'` writes zero bytes and reports
# success, which is the worst failure available because it looks seeded. So this
# mode carries everything through argv, base64'd, and rsync is not usable at all.
#
# exe.dev caps a relayed command at 64 KiB. Base64 inflates 4/3, and put_bytes
# wraps each chunk as `printf %s '...' >> dest`, so raw chunks stay at 32 KiB
# (about 44 KiB encoded). Linux's 128 KiB argv cap is not the binding limit:
# 60 KiB raw became 80 KiB on the wire and live seeding died with
# "request body exceeds 64KB limit". Credentials still fit in one hop; skills
# take more hops and about a minute, which is why the cost is announced.
if [ -n "$BACKEND" ]; then
  guest() { "$here/workenv-guest" "$BACKEND" "$SLOT" "$@"; }
  CHUNK=32768
  put_bytes() { # stdin -> remote path, chunked, mode 600
    local dest="$1" part tmp n=0
    tmp="$(mktemp -d)"
    split -b "$CHUNK" - "$tmp/p"
    guest "install -d -m 700 \"\$(dirname ~/$dest)\" && : > ~/$dest.b64"
    for part in "$tmp"/p*; do
      guest "printf %s '$(base64 < "$part" | tr -d '\n')' >> ~/$dest.b64"
      n=$((n + 1))
    done
    guest "base64 -d < ~/$dest.b64 > ~/$dest && rm -f ~/$dest.b64 && chmod 600 ~/$dest"
    printf '  %-30s %s chunk(s)\n' "$dest" "$n"
    rm -rf "$tmp"
  }

  log "identity '$IDENTITY' -> $SLOT"
  # Wiped first, and unconditionally. A slot is a reused name: seeding on top of
  # a previous tenant's files leaves that tenant's credentials in place wherever
  # this profile has no file of its own, which is exactly the bug the deleted
  # Lima pool shipped.
  "$here/workenv-identity-wipe" --via "$BACKEND" "$SLOT" --quiet

  while IFS= read -r spec; do
    src="$PROFILE/${spec%%:*}"
    dst="${spec##*:}"
    if [ -f "$src" ]; then
      put_bytes "$dst" <"$src"
      present=$((present + 1))
    else
      printf '  %-30s absent from profile\n' "$dst"
      missing=$((missing + 1))
    fi
  done < <(identity_files)

  identity_marker | put_bytes ".workenv-identity"
  # Idempotent: the block is removed before it is added, so reseeding a slot
  # cannot leave two of them, the second naming the previous tenant.
  guest 'for rc in .bashrc .profile; do
      [ -f "$HOME/$rc" ] || : > "$HOME/$rc"
      awk "/# >>> workenv identity >>>/{s=1} !s{print} /# <<< workenv identity <<</{s=0}" \
        "$HOME/$rc" > "$HOME/$rc.wkv" && mv "$HOME/$rc.wkv" "$HOME/$rc"
    done'
  guest "printf %s '$(printf '%s' "$MARKER_BLOCK" | base64 | tr -d '\n')' | base64 -d | tee -a ~/.bashrc >> ~/.profile"

  log "tooling"
  while IFS= read -r spec; do
    src="${spec%%:*}"
    dst="${spec##*:}"
    [ -f "$src" ] && put_bytes "$dst" <"$src"
  done < <(tooling_files)

  if [ "${WKV_SEED_SKILLS:-1}" = "1" ]; then
    # `.agents/skills` is included because `~/.claude/skills/*` are symlinks into
    # it -- drop it and every skill in the guest is a dangling link, which the
    # usual `find` count reports as present.
    log "skills (~3 MB; set WKV_SEED_SKILLS=0 to skip)"
    tar czf - -C "$HOME" .claude/skills .claude/commands .agents/skills .codex/skills 2>/dev/null |
      put_bytes "skills.tgz"
    guest 'tar xzf ~/skills.tgz -C ~ && rm -f ~/skills.tgz'
  fi

  log "what arrived"
  guest 'for f in .codex/auth.json .grok/auth.json .claude/.credentials.json .gitconfig .config/gh/hosts.yml .claude/CLAUDE.md; do
      [ -f ~/$f ] && printf "  %-30s %s bytes mode %s\n" "$f" "$(wc -c < ~/$f)" "$(stat -c %a ~/$f)"
    done
    for d in .claude/skills .agents/skills; do
      [ -d ~/$d ] && printf "  %-30s %s entries\n" "$d" "$(find ~/$d -mindepth 1 -maxdepth 1 | wc -l)"
    done'
  printf '\nseeded as %s: %s identity file(s) present, %s absent from the profile\n' \
    "$IDENTITY" "$present" "$missing"
  [ "$present" -gt 0 ] || die "profile '$IDENTITY' holds no credentials, so this guest can authenticate to nothing.
  The profile tree exists but was never logged in. Capture a session with:
    workenv-profile-import $IDENTITY [--from-gh-config <dir>]"
  echo SEED_DONE
  exit 0
fi
# --- ssh-reachable guests -------------------------------------------------

[ -n "$TARGET" ] || die "usage: workenv-seed <ssh-target> --identity <profile> | --via <backend> <vm> --identity <profile>"
SSH=(ssh -o BatchMode=yes)
RS=(rsync -az --delete -e "ssh -o BatchMode=yes")

"${SSH[@]}" "$TARGET" 'mkdir -p ~/.claude ~/.codex ~/.agents ~/.grok ~/.config/gh'

log "source trees the provisioner builds from"
# The provisioner builds apoc and reads the tool definitions from the workenv
# repo, so those sources must be present before it runs. Excludes are what keep
# this small: apoc's .build is 2.3G and its `target` is a symlink into a host
# cache that cargo then chokes on.
WORKENV_SRC="${WORKENV_SRC:-$HOME/Developer/src/workenv}"
APOC_SRC="${APOC_SRC:-$HOME/Developer/src/apoc}"
if [ -d "$WORKENV_SRC/modules" ]; then
  "${SSH[@]}" "$TARGET" 'mkdir -p ~/src/workenv'
  "${RS[@]}" --exclude '.state/' --exclude 'target/' --exclude '.git/' \
    "$WORKENV_SRC/" "$TARGET:src/workenv/"
  printf '  %-26s -> src/workenv\n' "workenv repo"
fi
if [ -d "$APOC_SRC/src" ]; then
  "${SSH[@]}" "$TARGET" 'mkdir -p ~/src/apoc'
  "${RS[@]}" --exclude '.build/' --exclude '.git/' --exclude 'target' --exclude '.state/' \
    "$APOC_SRC/" "$TARGET:src/apoc/"
  "${SSH[@]}" "$TARGET" 'rm -f ~/src/apoc/target'
  printf '  %-26s -> src/apoc\n' "apoc source"
fi

log "skills and agent definitions"
# Only the durable material. Caches, logs, session archives and artifacts are
# deliberately excluded: ~/.agents/artifacts alone is 33G.
for spec in \
  "$HOME/.claude/skills/:.claude/skills/" \
  "$HOME/.claude/commands/:.claude/commands/" \
  "$HOME/.claude/agents/:.claude/agents/" \
  "$HOME/.codex/skills/:.codex/skills/" \
  "$HOME/.codex/agents/:.codex/agents/" \
  "$HOME/.agents/skills/:.agents/skills/" ; do
  src="${spec%%:*}"; dst="${spec##*:}"
  if [ -d "$src" ]; then
    "${SSH[@]}" "$TARGET" "mkdir -p ~/$dst"
    "${RS[@]}" "$src" "$TARGET:$dst"
    printf '  %-26s -> %s\n' "$(basename "$(dirname "$src")")/$(basename "$src")" "$dst"
  fi
done

log "tooling"
while IFS= read -r spec; do
  src="${spec%%:*}"; dst="${spec##*:}"
  [ -f "$src" ] && { "${RS[@]}" "$src" "$TARGET:$dst"; printf '  %s\n' "$dst"; }
done < <(tooling_files)

log "identity '$IDENTITY' (streamed, never displayed)"
"$here/workenv-identity-wipe" "$TARGET" --quiet
put_secret() { # $1 = local file, $2 = remote path
  "${SSH[@]}" "$TARGET" "install -d -m 700 \$(dirname ~/$2) && cat > ~/$2 && chmod 600 ~/$2" < "$1"
  printf '  %-28s installed 0600 (%s bytes)\n' "$2" "$(wc -c < "$1" | tr -d ' ')"
}
while IFS= read -r spec; do
  src="$PROFILE/${spec%%:*}"
  dst="${spec##*:}"
  if [ -f "$src" ]; then
    put_secret "$src" "$dst"
    present=$((present + 1))
  else
    printf '  %-28s absent from profile\n' "$dst"
    missing=$((missing + 1))
  fi
done < <(identity_files)

identity_marker | "${SSH[@]}" "$TARGET" 'cat > ~/.workenv-identity && chmod 600 ~/.workenv-identity'
"${SSH[@]}" "$TARGET" 'for rc in .bashrc .profile; do
    [ -f "$HOME/$rc" ] || : > "$HOME/$rc"
    awk "/# >>> workenv identity >>>/{s=1} !s{print} /# <<< workenv identity <<</{s=0}" \
      "$HOME/$rc" > "$HOME/$rc.wkv" && mv "$HOME/$rc.wkv" "$HOME/$rc"
  done'
printf '%s\n' "$MARKER_BLOCK" | "${SSH[@]}" "$TARGET" 'tee -a ~/.bashrc >> ~/.profile'
printf '  %-28s installed\n' ".workenv-identity"

log "seed summary"
"${SSH[@]}" "$TARGET" 'for p in .claude/skills .claude/commands .codex/skills .agents/skills; do
    [ -d ~/$p ] && printf "  %-20s %s entries\n" "$p" "$(find ~/$p -mindepth 1 -maxdepth 1 | wc -l | tr -d " ")"
  done
  echo "  --- credentials present ---"
  for f in .codex/auth.json .grok/auth.json .claude/.credentials.json .gitconfig .config/gh/hosts.yml; do
    [ -f ~/$f ] && printf "  %-28s %s\n" "$f" "$(stat -c %a ~/$f)"
  done'
printf '\nseeded as %s: %s identity file(s) present, %s absent from the profile\n' \
  "$IDENTITY" "$present" "$missing"
[ "$present" -gt 0 ] || die "profile '$IDENTITY' holds no credentials, so this guest can authenticate to nothing.
  The profile tree exists but was never logged in. Capture a session with:
    workenv-profile-import $IDENTITY [--from-gh-config <dir>]"
echo SEED_DONE
